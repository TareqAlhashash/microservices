<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!--
    SPRING_ENDPOINT: FindSecBugs' informational marker that a class is web-reachable
    (@RestController / a Feign client interface Spring proxies as one), not a report of a
    specific defect. CustomizedResponseEntityExceptionHandler is a @RestController in every
    service that @Import's or extends it.
    -->
    <Match>
        <Bug pattern="SPRING_ENDPOINT" />
    </Match>
</FindBugsFilter>
