<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!--
    SPRING_ENDPOINT: FindSecBugs' informational marker that a class is web-reachable
    (@RestController / a Feign client interface Spring proxies as one), not a report of a
    specific defect - see common/spotbugs-exclude.xml for the fuller rationale.
    -->
    <Match>
        <Bug pattern="SPRING_ENDPOINT" />
    </Match>

    <!--
    SPRING_CSRF_PROTECTION_DISABLED: deliberate, not an oversight - see
    auth-service/spotbugs-exclude.xml for the fuller rationale. This is also a stateless,
    bearer-token API (SessionCreationPolicy.STATELESS) - there is no cookie/session a forged
    cross-site request could ride along on.
    -->
    <Match>
        <Class name="com.investorbook.apigateway.security.SecurityConfiguration" />
        <Bug pattern="SPRING_CSRF_PROTECTION_DISABLED" />
    </Match>

    <!--
    EI_EXPOSE_REP2 on DashboardService/LoginService storing a constructor-injected WebClient: the
    same category as every KafkaTemplate-holding class elsewhere in this repo (see order-service's
    spotbugs-exclude.xml) - a Spring-managed HTTP client, not a value type. There is nothing
    meaningful to "defensively copy" for a client object. Both share the one internalWebClient
    bean (see WebClientConfig).
    -->
    <Match>
        <Class name="com.investorbook.apigateway.service.DashboardService" />
        <Bug pattern="EI_EXPOSE_REP2" />
    </Match>
    <Match>
        <Class name="com.investorbook.apigateway.service.LoginService" />
        <Bug pattern="EI_EXPOSE_REP2" />
    </Match>
</FindBugsFilter>
